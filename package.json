{
	"name": "page-tree",
	"version": "0.3.6",
	"private": true,
	"description": "A local-first physical page tree for Obsidian.",
	"author": "alpadoze",
	"license": "MIT",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"package": "npm test && npm run build && node scripts/package-release.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"vitest": "^4.1.11"
	}
}
